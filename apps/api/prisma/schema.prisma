generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  emailVerifiedAt DateTime?
  authVersion Int @default(0)
  createdAt DateTime @default(now())
  memberships CompanyMember[]
  sessions Session[]
  emailChallenges EmailChallenge[]
  emailDeliveries EmailDelivery[]
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  authVersion Int @default(0)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
enum EmailPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
model EmailChallenge {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose EmailPurpose
  tokenHash String @unique
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  delivery EmailDelivery?
  @@unique([userId, purpose])
  @@index([expiresAt])
}
model EmailDelivery {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String? @unique
  challenge EmailChallenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  payloadCipher String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockId String?
  lockUntil DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([nextAttemptAt])
}
model EmailThrottle {
  key String @id
  nextAllowedAt DateTime
}
model Company {
  id String @id @default(uuid())
  name String
  legalName String?
  cnpj String?
  createdAt DateTime @default(now())
  memberships CompanyMember[]
  accounts MarketplaceAccount[]
}
model CompanyMember {
  userId String
  companyId String
  role Role @default(OWNER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@id([userId, companyId])
}
enum Role {
  OWNER
  ADMIN
  VIEWER
}
enum Marketplace {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
}
enum ConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
}
enum MarketplaceEnvironment {
  PRODUCTION
  SANDBOX
}
model MarketplaceAccount {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  marketplace Marketplace
  externalId String
  environment MarketplaceEnvironment @default(PRODUCTION)
  magaluSellerId String?
  magaluChannelId String?
  label String
  status ConnectionStatus @default(PENDING)
  createdAt DateTime @default(now())
  orders Order[]
  credentials MarketplaceCredential?
  lastSyncAt DateTime?
  syncFrom DateTime?
  syncTo DateTime?
  syncError String?
  nextSyncAt DateTime? @default(now())
  syncAttemptAt DateTime?
  syncFailures Int @default(0)
  lastFullSyncAt DateTime?
  syncLock String?
  syncLockUntil DateTime?
  @@unique([marketplace, externalId, environment])
  @@index([companyId])
  @@index([marketplace, status, nextSyncAt])
}
model MarketplaceCredential {
  accountId String @id
  account MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenCipher String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
model OAuthAttempt {
  stateHash String @id
  sessionHash String
  userId String
  companyId String
  verifierCipher String
  codeCipher String?
  denied Boolean @default(false)
  expiresAt DateTime
  @@index([expiresAt])
}
// Isolated from Mercado Livre: states cannot be completed by another provider.
model MagaluOAuthAttempt {
  stateHash String @id
  sessionHash String
  userId String
  companyId String
  environment MarketplaceEnvironment @default(PRODUCTION)
  codeCipher String?
  denied Boolean @default(false)
  expiresAt DateTime
  @@index([expiresAt])
}
model ShopeeOAuthAttempt {
  stateHash String @id
  sessionHash String
  userId String
  companyId String
  partnerId String
  environment MarketplaceEnvironment
  codeCipher String?
  denied Boolean @default(false)
  expiresAt DateTime
  @@index([expiresAt])
}
model Order {
  id String @id @default(uuid())
  accountId String
  account MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId String
  status String
  currency String @default("BRL")
  grossAmount Decimal? @db.Decimal(18,2)
  orderedAt DateTime
  updatedAt DateTime @updatedAt
  items OrderItem[]
  snapshot Json?
  @@unique([accountId, externalId])
  @@index([accountId, orderedAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalSku String?
  title String
  quantity Int
  unitPrice Decimal? @db.Decimal(18,2)
}
